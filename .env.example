# Postgres (e.g. Neon). Neon's Vercel integration sets both automatically.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Auth.js secret — generate with: npx auth secret   (or any long random string)
AUTH_SECRET="a-long-random-string"

# Vercel Blob token for file storage. Leave unset locally to store files in public/uploads instead.
# BLOB_READ_WRITE_TOKEN=""

# Admin account created by `prisma db seed` (required on Vercel; defaults to admin@certiflow.com / admin123 locally)
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="choose-a-strong-password"
